import os
import pandas as pd

configfile: "config/config.yaml"

samples = pd.read_csv(config["samples"], sep="\t").set_index("sample", drop=False)
SAMPLES = list(samples.index)
OUT = config["outdir"]

wildcard_constraints:
    read="[12]",
    sample="SRR[0-9]+"


def raw_fq(wc):
    return samples.loc[wc.sample, "fq1" if wc.read == "1" else "fq2"]


rule all:
    input:
        expand(OUT + "/fastqc_raw/{sample}_{read}_fastqc.html", sample=SAMPLES, read=["1", "2"]),
        expand(OUT + "/fastqc_trimmed/{sample}_{read}_fastqc.html", sample=SAMPLES, read=["1", "2"]),
        expand(OUT + "/hisat2/{sample}.bam.bai", sample=SAMPLES),
        OUT + "/featurecounts/counts.txt",
        expand(OUT + "/kallisto/{sample}/abundance.tsv", sample=SAMPLES)


rule fastqc_raw:
    input: raw_fq
    output:
        html=OUT + "/fastqc_raw/{sample}_{read}_fastqc.html",
        zip=OUT + "/fastqc_raw/{sample}_{read}_fastqc.zip"
    log: OUT + "/logs/fastqc_raw/{sample}_{read}.log"
    conda: "../envs/qc.yaml"
    threads: 2
    resources: mem_mb=2000, runtime=60
    shell: "fastqc -t {threads} --outdir {OUT}/fastqc_raw {input} > {log} 2>&1"


rule fastp:
    input:
        r1=lambda wc: samples.loc[wc.sample, "fq1"],
        r2=lambda wc: samples.loc[wc.sample, "fq2"]
    output:
        r1=OUT + "/trimmed/{sample}_1.fastq.gz",
        r2=OUT + "/trimmed/{sample}_2.fastq.gz",
        json=OUT + "/fastp/{sample}.json",
        html=OUT + "/fastp/{sample}.html"
    log: OUT + "/logs/fastp/{sample}.log"
    conda: "../envs/qc.yaml"
    params: extra=config["fastp_extra"]
    threads: 16
    resources: mem_mb=8000, runtime=240
    shell:
        "fastp -i {input.r1} -I {input.r2} -o {output.r1} -O {output.r2} "
        "-j {output.json} -h {output.html} -w {threads} {params.extra} > {log} 2>&1"


rule fastqc_trimmed:
    input: OUT + "/trimmed/{sample}_{read}.fastq.gz"
    output:
        html=OUT + "/fastqc_trimmed/{sample}_{read}_fastqc.html",
        zip=OUT + "/fastqc_trimmed/{sample}_{read}_fastqc.zip"
    log: OUT + "/logs/fastqc_trimmed/{sample}_{read}.log"
    conda: "../envs/qc.yaml"
    threads: 2
    resources: mem_mb=2000, runtime=60
    shell: "fastqc -t {threads} --outdir {OUT}/fastqc_trimmed {input} > {log} 2>&1"


include: "align.smk"
include: "quant.smk"
